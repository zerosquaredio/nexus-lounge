# Normalize text files to LF in the repo and working copy.
* text=auto eol=lf

# Windows scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ANSI art and fonts are bytes: never convert their line ends.
*.ans binary
*.ANS binary
*.woff binary
*.woff2 binary
*.psf binary

# Models and pictures are bytes too.
*.glb binary
*.png binary
*.jpg binary
*.jpeg binary
